Ref: rules.version_id > scenario_versions.id [delete: cascade]
Ref: educational_references.version_id > scenario_versions.id [delete: cascade]
Ref: question_sets.version_id > scenario_versions.id [delete: cascade]

Ref: nodes.(version_id, default_next_node_id) > nodes.(version_id, id)
Ref: decision_points.(version_id, node_id) - nodes.(version_id, id) [delete: cascade]
Ref: decision_points.(version_id, learning_objective_id) > learning_objectives.(version_id, id)
Ref: options.(version_id, node_id) > decision_points.(version_id, node_id) [delete: cascade]
Ref: options.(version_id, next_node_id) > nodes.(version_id, id)
