Ref: rules.(version_id, from_node_id) > nodes.(version_id, id)
Ref: rules.(version_id, target_node_id) > nodes.(version_id, id)
Ref: decision_references.(version_id, node_id) > decision_points.(version_id, node_id) [delete: cascade]
Ref: decision_references.(version_id, reference_id) > educational_references.(version_id, id) [delete: cascade]
Ref: feedback_items.(version_id, node_id) > nodes.(version_id, id) [delete: cascade]
Ref: feedback_items.(version_id, option_id) > options.(version_id, id) [delete: cascade]
Ref: questions.(version_id, question_set_id) > question_sets.(version_id, id) [delete: cascade]
Ref: questions.(version_id, learning_objective_id) > learning_objectives.(version_id, id)
Ref: questions.(version_id, assesses_decision_node_id) > decision_points.(version_id, node_id)
Ref: questions.(version_id, requires_node_id) > nodes.(version_id, id)
Ref: question_options.(version_id, question_id) > questions.(version_id, id) [delete: cascade]

// =====================================================================
// Relaciones · identidad
// =====================================================================
Ref: participants.account_id - accounts.id [delete: cascade]
Ref: document_acceptances.participant_id > participants.id [delete: cascade]
Ref: consent_events.account_id > accounts.id [delete: cascade]
Ref: arco_requests.account_id > accounts.id [delete: set null]
Ref: arco_requests.assigned_admin_id > admin_users.id [delete: set null]

// =====================================================================
// Relaciones · simulación
// =====================================================================
Ref: sessions.participant_id > participants.id [delete: cascade]
Ref: sessions.scenario_version_id > scenario_versions.id [delete: restrict]
Ref: sessions.(scenario_version_id, current_node_id) > nodes.(version_id, id)
Ref: sessions.(scenario_version_id, outcome_node_id) > nodes.(version_id, id)

Ref: session_steps.(session_id, scenario_version_id) > sessions.(id, scenario_version_id) [delete: cascade]
Ref: session_steps.(scenario_version_id, node_id) > nodes.(version_id, id)

Ref: session_decisions.(session_id, scenario_version_id) > sessions.(id, scenario_version_id) [delete: cascade]
Ref: session_decisions.(scenario_version_id, node_id) > decision_points.(version_id, node_id)
Ref: session_decisions.(node_id, option_id) > options.(node_id, id)

Ref: session_decision_reasons.(session_decision_id, node_id) > session_decisions.(id, node_id) [delete: cascade]
Ref: session_decision_reasons.(node_id, reason_id) > justification_reasons.(node_id, id)

Ref: session_variables.(session_id, scenario_version_id) > sessions.(id, scenario_version_id) [delete: cascade]
Ref: session_variables.(scenario_version_id, variable_id) > state_variables.(version_id, id)

Ref: session_effects.(session_decision_id, session_id) > session_decisions.(id, session_id) [delete: cascade]
Ref: session_effects.(session_id, variable_id) > session_variables.(session_id, variable_id) [delete: cascade]

Ref: session_events.(session_id, scenario_version_id) > sessions.(id, scenario_version_id) [delete: cascade]
Ref: session_events.(scenario_version_id, rule_id) > rules.(version_id, id)

Ref: session_event_causes.(session_event_id, session_id) > session_events.(id, session_id) [delete: cascade]
Ref: session_event_causes.(session_decision_id, session_id) > session_decisions.(id, session_id) [delete: cascade]

Ref: assessment_attempts.(session_id, scenario_version_id) > sessions.(id, scenario_version_id) [delete: cascade]
Ref: assessment_attempts.(scenario_version_id, question_set_id) > question_sets.(version_id, id)

Ref: assessment_answers.(attempt_id, question_set_id) > assessment_attempts.(id, question_set_id) [delete: cascade]
Ref: assessment_answers.(question_set_id, question_id) > questions.(question_set_id, id)
Ref: assessment_answers.(question_id, option_id) > question_options.(question_id, id)

